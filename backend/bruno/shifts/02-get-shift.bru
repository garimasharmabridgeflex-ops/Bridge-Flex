meta {
  name: Get Shift
  type: http
  seq: 2
}

get {
  url: {{coreBaseUrl}}:8107/?shiftId=shift-open-1
  body: none
  auth: none
}

params:query {
  shiftId: shift-open-1
}

headers {
  Authorization: Bearer {{idToken}}
}

docs {
  functions-core: GetShift (port 8107). Try shiftId=shift-booked-1 while
  signed in as staff-sam (not a party to that shift) — expect 403
  NOT_VISIBLE, since a booked shift is only fully readable by its nursery and
  booked staff (§3).
}
