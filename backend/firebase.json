{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/GetPlatformStats",
        "function": { "functionId": "GetPlatformStats", "region": "europe-west2" }
      },
      {
        "source": "/ListPendingDocuments",
        "function": { "functionId": "ListPendingDocuments", "region": "europe-west2" }
      },
      {
        "source": "/ReviewDocument",
        "function": { "functionId": "ReviewDocument", "region": "europe-west2" }
      },
      {
        "source": "/ListAllUsers",
        "function": { "functionId": "ListAllUsers", "region": "europe-west2" }
      },
      {
        "source": "/GetUserDetail",
        "function": { "functionId": "GetUserDetail", "region": "europe-west2" }
      },
      {
        "source": "/SetVerificationBadge",
        "function": { "functionId": "SetVerificationBadge", "region": "europe-west2" }
      },
      {
        "source": "/SetUserSuspended",
        "function": { "functionId": "SetUserSuspended", "region": "europe-west2" }
      },
      {
        "source": "/ListTimesheets",
        "function": { "functionId": "ListTimesheets", "region": "europe-west2" }
      },
      {
        "source": "/AdminApproveTimesheet",
        "function": { "functionId": "AdminApproveTimesheet", "region": "europe-west2" }
      },
      {
        "source": "/ListInvoices",
        "function": { "functionId": "ListInvoices", "region": "europe-west2" }
      },
      {
        "source": "/MarkInvoicePaid",
        "function": { "functionId": "MarkInvoicePaid", "region": "europe-west2" }
      },
      {
        "source": "/ListPayrollPeriods",
        "function": { "functionId": "ListPayrollPeriods", "region": "europe-west2" }
      },
      {
        "source": "/GeneratePayrollPeriod",
        "function": { "functionId": "GeneratePayrollPeriod", "region": "europe-west2" }
      },
      {
        "source": "/ExportPayrollCSV",
        "function": { "functionId": "ExportPayrollCSV", "region": "europe-west2" }
      },
      {
        "source": "/GetVettingChecklist",
        "function": { "functionId": "GetVettingChecklist", "region": "europe-west2" }
      },
      {
        "source": "/ApprovePractitionerVetting",
        "function": { "functionId": "ApprovePractitionerVetting", "region": "europe-west2" }
      },
      {
        "source": "/RejectPractitionerVetting",
        "function": { "functionId": "RejectPractitionerVetting", "region": "europe-west2" }
      },
      {
        "source": "/ApproveNurseryRegistration",
        "function": { "functionId": "ApproveNurseryRegistration", "region": "europe-west2" }
      },
      {
        "source": "/RejectNurseryRegistration",
        "function": { "functionId": "RejectNurseryRegistration", "region": "europe-west2" }
      },
      {
        "source": "/ListBranches",
        "function": { "functionId": "ListBranches", "region": "europe-west2" }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8180,
      "host": "0.0.0.0"
    },
    "pubsub": {
      "port": 8085,
      "host": "0.0.0.0"
    },
    "storage": {
      "port": 9199,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "0.0.0.0"
    },
    "singleProjectMode": true
  }
}
