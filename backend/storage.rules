rules_version = '2';

// Storage rules are enforced independently from firestore.rules (§2 of
// ARCHITECTURE.md v2) — a client could otherwise write a `documents` Firestore
// doc without a matching upload, or vice versa, so both layers validate the
// same `dbs-documents/{uid}/...` path convention.
service firebase.storage {
  match /b/{bucket}/o {
    match /dbs-documents/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Generalized documents checklist (CV, id, qualification, first_aid,
    // right_to_work) — same shape as dbs-documents above but grouped by
    // type under the uid so Storage listing/rules stay per-type without a
    // new match block per document type.
    match /personal-documents/{uid}/{docType}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Profile/nursery photos (full app spec §1.2/§1.3) are shown on public
    // profile screens to any signed-in user — unlike dbs-documents, these
    // are meant to be seen by the other party, so read is any authenticated
    // user, not owner-only. Write stays owner-only, same size/type limits.
    match /profile-photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /nursery-photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Training module videos (Bridge Flex Training & Onboarding Modules).
    // Readable by any signed-in user — every practitioner has to watch these,
    // and they contain no personal data. Writable only by an admin: unlike
    // the paths above there is no owning uid in the path, so without the
    // admin claim any authenticated user could overwrite the training
    // content everyone else is shown.
    match /training-videos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
