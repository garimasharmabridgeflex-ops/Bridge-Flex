# Fastlane config for CI-only iOS release builds. Nothing here is meant to be
# run from a developer's Mac -- it creates a throwaway keychain and rewrites
# signing settings in Runner.xcodeproj, which you don't want happening in a
# working copy you're also developing in.
#
# Why Fastlane at all: plain `xcodebuild -allowProvisioningUpdates` can only
# create provisioning profiles under *automatic* signing, and automatic signing
# insists on minting an iOS App Development profile first -- which Apple refuses
# to issue for a team with no registered device UDIDs. Fastlane's sigh talks to
# the App Store Connect API directly and can create an App Store *distribution*
# profile with zero devices registered, which is what a TestFlight/App Store
# build actually needs.

default_platform(:ios)

APP_IDENTIFIER = "com.bridgeflex.bridgeflexApp"
KEYCHAIN_NAME = "bridgeflex-ci"

platform :ios do
  desc "Build a signed release IPA and upload it to TestFlight"
  lane :ci_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_API_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_API_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    keychain_password = ENV.fetch("KEYCHAIN_PASSWORD")

    create_keychain(
      name: KEYCHAIN_NAME,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    keychain_path = File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")

    # Apple caps an account at 2 distribution certificates, and it never hands
    # back the private key of an existing one. So on an ephemeral CI runner
    # `get_certificates` has no choice but to create a *new* certificate every
    # run, which would exhaust that cap within a couple of builds.
    #
    # To avoid that: after the first successful run, export the generated
    # certificate as a .p12 and store it (base64) as the DIST_CERT_P12 secret
    # with its password as DIST_CERT_PASSWORD. When those are present we import
    # and reuse them instead of asking Apple for another certificate.
    if (ENV["DIST_CERT_P12"] || "").empty?
      UI.important("DIST_CERT_P12 not set -- asking Apple for a new distribution certificate.")
      UI.important("Apple allows only 2, and the private key of one created here dies with this runner.")
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        output_path: "./build/certs"
      )

      # Export the identity (certificate + private key) so it can be stored as
      # a secret and reused, instead of asking Apple for a new certificate on
      # every run until the 2-certificate cap is hit.
      #
      # Gated on DIST_CERT_PASSWORD deliberately: the export is a private key,
      # and it gets uploaded as a workflow artifact that anyone with repo read
      # access can download. Requiring a passphrase means what leaves this job
      # is at least encrypted rather than a bare key.
      if (ENV["DIST_CERT_PASSWORD"] || "").empty?
        UI.important("DIST_CERT_PASSWORD not set -- skipping certificate export.")
        UI.important("This certificate's private key will be LOST when this runner is destroyed,")
        UI.important("permanently consuming one of your 2 certificate slots. Set DIST_CERT_PASSWORD")
        UI.important("to have future runs export a reusable encrypted .p12 instead.")
      else
        # Derive the output directory from where cert actually put the .cer,
        # rather than expanding a relative path. Relative paths are unreliable
        # here: fastlane's own actions, its `sh` helper, and plain Ruby all
        # resolve them against different working directories, which has
        # already caused both a failed export and an export written somewhere
        # the workflow's artifact step couldn't find.
        certs_dir = File.dirname(lane_context[SharedValues::CERT_FILE_PATH])
        export_path = File.join(certs_dir, "dist.p12")
        FileUtils.mkdir_p(certs_dir)
        sh(
          "security", "export",
          "-k", keychain_path,
          "-t", "identities",
          "-f", "pkcs12",
          "-P", ENV.fetch("DIST_CERT_PASSWORD"),
          "-o", export_path
        )
        require "base64"
        File.write("#{export_path}.base64", Base64.strict_encode64(File.binread(export_path)))
        UI.success("Exported an encrypted .p12 to #{export_path}.base64.")
        UI.success("Download it from this run's artifacts and store its contents as the")
        UI.success("DIST_CERT_P12 secret so subsequent runs reuse this certificate.")
      end
    else
      UI.message("Importing the stored distribution certificate from DIST_CERT_P12.")
      require "base64"
      p12_path = File.expand_path("./build/certs/dist.p12")
      FileUtils.mkdir_p(File.dirname(p12_path))
      File.binwrite(p12_path, Base64.decode64(ENV.fetch("DIST_CERT_P12")))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
        keychain_name: KEYCHAIN_NAME,
        keychain_password: keychain_password
      )
    end

    # An App Store profile is sigh's default, and it's the only profile type
    # Apple will issue with no devices registered. `development` and `adhoc`
    # are deliberately NOT passed: sigh rejects them as conflicting options
    # whenever both are supplied, even when both are set to false.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true,
      output_path: "./build/profiles"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Signing with provisioning profile: #{profile_name}")

    # Pin manual signing on the Runner target only. Doing this via build
    # settings on the target (rather than global xcodebuild flags) matters:
    # a global CODE_SIGN_* override also hits every SPM/CocoaPods dependency
    # target and breaks their own signing/entitlements resolution.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["Runner"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build/ipa",
      output_name: "BridgeFlex.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      # The build still has to finish Apple-side processing before it's
      # installable, but there's no value in holding a CI job open for it.
      skip_waiting_for_build_processing: true
    )
  end
end
